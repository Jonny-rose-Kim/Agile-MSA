# ===== 대용량 바이너리 (GitHub 100MB 제한 초과) =====
*.tar
*.zip
msa-lecture-images.part.*

# ===== 강의 교재 / 가이드 PDF (제3자 저작물) =====
*.pdf

# ===== 원본 실습 템플릿 (참고용 로컬 사본, 저장소에는 포함하지 않음) =====
msa-lecture/

# ===== 의존성 =====
node_modules/

# ===== 빌드 산출물 =====
build/
bin/
dist/
out/
.gradle/
*.class
*.jar
# 하위 서비스의 래퍼까지 포함되도록 **/ 를 붙인다.
# (경로 구분자가 들어간 패턴은 .gitignore 위치 기준으로 고정된다)
!**/gradle/wrapper/gradle-wrapper.jar

# ===== IDE / OS =====
.DS_Store
.idea/
.vscode/
*.iml
*.log

# 로컬 전용 compose 오버라이드
docker-compose.override.yml

# 시크릿 (API 키 등). .env.example 만 커밋한다.
.env
.env.local
!.env.example
