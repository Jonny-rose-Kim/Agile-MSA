# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋되지 않는다.
#   cp .env.example .env

# 서버 설정
APP_PORT=8085
APP_NAME=recommend-service

# Eureka 설정
EUREKA_SERVER_URL=http://localhost:8761/eureka
EUREKA_INSTANCE_HOST=localhost

# Auth Server (JWT 검증)
JWT_ISSUER_URI=http://localhost:8080
JWK_SET_URI=http://localhost:9000/oauth2/jwks

# 의존 서비스 (미구현이면 MOCK_MODE=true)
MOCK_MODE=true
MATERIAL_SERVICE_URL=http://localhost:8086
ORDER_SERVICE_URL=http://localhost:8087

# ===== 수요 예측 =====
# llm  = OpenAI Responses API + web_search
# mock = 합성 데이터 추세 (SYNTHETIC_TREND). OpenAI 호출 없음
# 키 없이도 바로 뜨도록 mock 이 기본이다. 키를 넣었다면 llm 으로 바꾼다.
FORECASTER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# web_search를 쓰면 10초를 넘기는 경우가 많다. 넉넉히 잡는 것을 권장.
OPENAI_TIMEOUT=10
FORECAST_CACHE_TTL_HOURS=6

# 소진 시뮬레이션
LEAD_TIME_DAYS=30
FORECAST_DEFAULT_DAYS=90
FACTOR_RECENT_WEEKS=12
RECOMMEND_MAX_COUNT=5

# 데모용. 합성 발주 이력 구간(2025-07-14 ~ 2026-08-16) 안이어야 한다.
DEMO_AS_OF=2026-03-12
MOCK_CONFIDENCE=0.72

